# Jetyard configuration.
# Copy to .env and fill in. Never commit .env (it is in .gitignore).
#
# docker compose reads the three secrets in the first section from this file.
# The other variables are for running the backend directly (`make backend`) or
# for overriding the defaults; docker-compose.yml already sets the ones the
# bundled stack needs.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Signs dashboard login sessions. At least 32 characters.
# If unset, a random secret is generated at every start and everyone is
# logged out on restart.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Operator NKey seed (starts with SO). Enables the Accounts and Users pages:
# the dashboard signs account JWTs with it. Leave empty to disable them.
# Generate: nsc generate nkey --operator
# Your NATS server must trust the matching operator public key.
OPERATOR_NKEY_SEED=

# Optional. Encrypts NATS account seeds (NATS_STORE_FILE) and the NATS
# password, token and TLS client key saved from the Settings page
# (NATS_SETTINGS_FILE) with AES-256-GCM. 32 bytes, base64.
# Once set, keep it: those values can't be read back without it.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# NATS connection (backend). The Settings page can override these at runtime;
# saved settings take priority.
# ---------------------------------------------------------------------------

# NATS server the backend connects to.
# NATS_URL=nats://localhost:4222

# NATS credentials: either a user and password, or a token.
# NATS_USER=
# NATS_PASSWORD=
# NATS_TOKEN=

# NATS monitoring port (nats-server -m 8222), used for Server Info and the
# connections/subscriptions pages. Must be reachable from the backend.
# NATS_MONITOR_PORT=8222

# ---------------------------------------------------------------------------
# Backend HTTP server
# ---------------------------------------------------------------------------

# Port the backend API listens on.
# SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API (CORS). Must include
# the URL you open the dashboard at. Not needed with the single Docker image,
# where the UI and the API share one origin.
# ALLOWED_ORIGINS=http://localhost:3000

# Directory with the exported frontend (frontend/out). When set, the backend
# serves the UI itself. The Docker image sets it to /app/web.
# STATIC_DIR=

# ---------------------------------------------------------------------------
# docker-compose.prod.yml only
# ---------------------------------------------------------------------------

# Image to run (default ghcr.io/imadmansour85/jetyard:latest).
# JETYARD_IMAGE=
# Host address for the dashboard port. Use 127.0.0.1:3000 behind Caddy.
# LISTEN=3000
# Public domain for the Caddy HTTPS profile (--profile tls).
# DOMAIN=nats.example.com

# ---------------------------------------------------------------------------
# Persistence (backend). Defaults point at the /data volume in Docker; set
# these when running the backend outside Docker, where /data usually doesn't
# exist.
# ---------------------------------------------------------------------------

# Dashboard users and password hashes.
# AUTH_USERS_FILE=/data/auth-users.json

# NATS accounts (with their seeds) and users created from the dashboard.
# NATS_STORE_FILE=/data/nats-store.json

# NATS connection settings saved from the Settings page.
# NATS_SETTINGS_FILE=/data/nats-settings.json

# ---------------------------------------------------------------------------
# Logging (backend)
# ---------------------------------------------------------------------------

# text (default) or json.
# LOG_FORMAT=text

# debug, info (default), warn or error.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (build time: NEXT_PUBLIC_* values are inlined into the bundle)
# ---------------------------------------------------------------------------

# Backend URL as seen from the user's browser.
# NEXT_PUBLIC_API_URL=http://localhost:8080
